diff --git a/vllm_ascend/diagnostics.py b/vllm_ascend/diagnostics.py
new file mode 100644
index 000000000..085c073af
--- /dev/null
+++ b/vllm_ascend/diagnostics.py
@@ -0,0 +1,116 @@
+"""Opt-in DSpark/UCM numerical diagnostics.
+
+Set VLLM_ASCEND_DSPARK_DIAG=1 to enable. All helpers are best-effort and
+intentionally synchronize NPU work when enabled.
+"""
+
+from __future__ import annotations
+
+import logging
+import os
+from collections import defaultdict
+from collections.abc import Sequence
+
+import torch
+
+logger = logging.getLogger("vllm_ascend.diagnostics")
+_ENABLED = os.getenv("VLLM_ASCEND_DSPARK_DIAG", "0").lower() in ("1", "true", "yes")
+_EVERY = max(int(os.getenv("VLLM_ASCEND_DSPARK_DIAG_EVERY", "1")), 1)
+_MAX_LAYERS = int(os.getenv("VLLM_ASCEND_DSPARK_DIAG_MAX_LAYERS", "0"))
+_MAX_BLOCKS = max(int(os.getenv("VLLM_ASCEND_DSPARK_DIAG_MAX_BLOCKS", "1")), 1)
+_ID_LIMIT = max(int(os.getenv("VLLM_ASCEND_DSPARK_DIAG_ID_LIMIT", "16")), 1)
+_counts: dict[str, int] = defaultdict(int)
+
+
+def _selected(name: str) -> bool:
+    if not _ENABLED:
+        return False
+    _counts[name] += 1
+    return _counts[name] % _EVERY == 1
+
+
+def tensor_stats(name: str, tensor: torch.Tensor | None) -> None:
+    if tensor is None or not isinstance(tensor, torch.Tensor) or not _selected(name):
+        return
+    try:
+        value = tensor.detach()
+        shape = tuple(value.shape)
+        dtype = value.dtype
+        if value.is_floating_point() or value.is_complex():
+            nan_count = int(torch.isnan(value).sum().item())
+            posinf_count = int((value == float("inf")).sum().item())
+            neginf_count = int((value == float("-inf")).sum().item())
+            finite = value[torch.isfinite(value)]
+        else:
+            nan_count = posinf_count = neginf_count = 0
+            finite = value
+        if finite.numel() > 0:
+            minimum = float(finite.min().item())
+            maximum = float(finite.max().item())
+        else:
+            minimum = maximum = float("nan")
+        logger.warning(
+            "[DSPARK_DIAG] %s shape=%s dtype=%s device=%s nan=%d +inf=%d -inf=%d min=%r max=%r",
+            name,
+            shape,
+            dtype,
+            value.device,
+            nan_count,
+            posinf_count,
+            neginf_count,
+            minimum,
+            maximum,
+        )
+    except Exception as error:
+        logger.exception("[DSPARK_DIAG] %s failed: %s", name, error)
+
+
+def token_ids(name: str, tensor: torch.Tensor | None) -> None:
+    if tensor is None or not isinstance(tensor, torch.Tensor) or not _selected(name):
+        return
+    try:
+        flat = tensor.detach().flatten()
+        ids = flat[:_ID_LIMIT].cpu().tolist()
+        logger.warning(
+            "[DSPARK_DIAG] %s shape=%s dtype=%s ids=%s",
+            name,
+            tuple(tensor.shape),
+            tensor.dtype,
+            ids,
+        )
+    except Exception as error:
+        logger.exception("[DSPARK_DIAG] %s failed: %s", name, error)
+
+
+def cache_views(
+    name: str,
+    kvcaches: dict[str, torch.Tensor | Sequence[torch.Tensor]],
+    block_ids: Sequence[int],
+) -> None:
+    if not _ENABLED or not kvcaches or not block_ids:
+        return
+    layer_names = sorted(kvcaches)
+    if _MAX_LAYERS > 0:
+        layer_names = layer_names[:_MAX_LAYERS]
+    for layer_name in layer_names:
+        kv_layer = kvcaches[layer_name]
+        components = [kv_layer] if isinstance(kv_layer, torch.Tensor) else list(kv_layer)
+        for raw_block_id in list(block_ids)[:_MAX_BLOCKS]:
+            block_id = int(raw_block_id)
+            for component_index, component in enumerate(components):
+                try:
+                    block = component[block_id]
+                except Exception as error:
+                    logger.warning(
+                        "[DSPARK_DIAG] %s layer=%s block=%d component=%d invalid: %s",
+                        name,
+                        layer_name,
+                        block_id,
+                        component_index,
+                        error,
+                    )
+                    continue
+                tensor_stats(
+                    f"{name}.layer={layer_name}.block={block_id}.component={component_index}",
+                    block,
+                )
